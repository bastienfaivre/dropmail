# ==============================================================================
# Dropmail Backend Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# REQUIRED variables must be set for the application to start.
# OPTIONAL variables have sensible defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED: Cloudflare Turnstile Configuration
# ------------------------------------------------------------------------------
# Get your secret key from: https://dash.cloudflare.com/turnstile
# The secret key is used for server-side verification of Turnstile tokens.
# Format: 0x followed by alphanumeric characters
TURNSTILE_SECRET=your-turnstile-secret-key

# ------------------------------------------------------------------------------
# REQUIRED: CORS Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin requests.
# Include all domains where the form will be embedded.
# Example for production: https://example.com,https://notion.so
# Example for development: http://localhost:80,http://localhost:3000
CORS_ORIGINS=http://localhost:80,http://localhost:3000

# ------------------------------------------------------------------------------
# OPTIONAL: Server Configuration
# ------------------------------------------------------------------------------
# Server port (default: 8080)
# PORT=8080

# SQLite database path (default: /data/dropmail.db)
# In Docker, this should match the volume mount point.
# DB_PATH=/data/dropmail.db
